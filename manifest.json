{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.2.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content/i18n.js",
        "content/theme.js",
        "content/emoji-order.js",
        "content/phrases.js"
      ],
      "css": [
        "content/emoji-order.css",
        "content/phrases.css"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
